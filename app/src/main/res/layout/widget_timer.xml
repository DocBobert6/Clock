<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_timer_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Timer"
        android:textColor="#8E8E93"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Chronometer
        android:id="@+id/widget_timer_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6dp"
        android:countDown="true"
        android:format="%s"
        android:textColor="#0A84FF"
        android:textSize="36sp" />

    <TextView
        android:id="@+id/widget_timer_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Tap preset to start"
        android:textColor="#8E8E93"
        android:textSize="12sp" />

    <!-- Presets or Controls row -->
    <LinearLayout
        android:id="@+id/widget_timer_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_timer_preset_1"
            android:layout_width="54dp"
            android:layout_height="36dp"
            android:backgroundTint="#2C2C2E"
            android:text="1m"
            android:textColor="#0A84FF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_timer_preset_5"
            android:layout_width="54dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#2C2C2E"
            android:text="5m"
            android:textColor="#0A84FF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_timer_btn_cancel"
            android:layout_width="54dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#38383A"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
